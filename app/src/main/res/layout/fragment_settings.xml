<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/DarkLightModeBackground"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/todo_settings_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHeight_percent="0.2"
        android:background="@color/blue"
        />
    <TextView
        android:id="@+id/settings_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_text"
        style="@style/TitlesTextStyle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/todo_settings_fragment_container"
        android:layout_marginStart="20dp"
        />
    <TextView
        android:id="@+id/language_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/todo_settings_fragment_container"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/language"
        style="@style/LargeTitleTextStyle"
        android:layout_margin="30dp"
        />

    <Spinner
        android:id="@+id/language_spinner_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.8"
        app:layout_constraintHeight_percent="0.06"
        app:layout_constraintTop_toBottomOf="@id/language_text_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="20dp"
        android:background="@drawable/language_spinner_bg"
        />

    <TextView
        android:id="@+id/mode_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/language_spinner_view"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/mode"
        style="@style/LargeTitleTextStyle"
        android:layout_margin="30dp"
        />

    <Spinner
        android:id="@+id/mode_spinner_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.8"
        app:layout_constraintHeight_percent="0.06"
        app:layout_constraintTop_toBottomOf="@id/mode_text_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="20dp"
        android:background="@drawable/language_spinner_bg"
        />


</androidx.constraintlayout.widget.ConstraintLayout>