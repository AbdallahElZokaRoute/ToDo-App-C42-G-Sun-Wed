<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.ToDoAppC42GSunWed" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSurface">@color/black2</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="LargeTitleTextStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MediumSubTitleTextStyle">
        <item name="android:textColor">@color/gray3</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="LightDescriptionTextStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PrimaryTitleTextStyle">
        <item name="android:textColor">@color/blue</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DayViewBackGround">
        <item name="android:background">@drawable/rounded_black_bg</item>
    </style>
</resources>
